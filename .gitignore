# ==============================================================================
# MargSetu — Master .gitignore
# ==============================================================================

# Environment & Sensitive Credentials (NEVER COMMIT)
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!.env.example
!*.env.example
!**/.env.example
*.pem
*.key
*.cert
credentials.json
service-account*.json

# Python Virtual Environments & Caches
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Node & Frontend Build Artefacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.pnp
.pnp.js
*.tsbuildinfo

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & Runtime State
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
margsetu.db*

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
