# ==============================================================================
# MargSetu Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your API keys:
#   cp .env.example .env

# Google Gemini API Key (Optional — fallback deterministic templates are used if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Map Tile Providers (Optional — defaults to OpenStreetMap/Carto public CDN)
MAPBOX_TOKEN=your_mapbox_token_here
CARTO_KEY=your_carto_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
